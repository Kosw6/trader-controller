HTTP_ADDR=:8090
DATABASE_URL=postgres://trader:trader@localhost:5432/trader?sslmode=disable
ADMIN_API_KEY=change-me
ADMIN_USERNAME=admin
# Generate with bcrypt. Example helper: python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL=8h
ADMIN_COOKIE_SECURE=false
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL=10s
SCHEDULER_BATCH_SIZE=20
DB_MAX_CONNS=10
DB_MIN_CONNS=2
SHUTDOWN_TIMEOUT=10s

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=trader.jobs.events
KAFKA_ALLOW_AUTO_TOPIC_CREATION=false
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_INTERVAL=5s
OUTBOX_PUBLISH_TIMEOUT=10s
OUTBOX_HEALTH_TIMEOUT=3s
OUTBOX_STALE_AFTER=5m
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_DELAY=10s
OUTBOX_RETRY_MAX_DELAY=5m
OUTBOX_RUN_ONCE=false

# Requires mapper667 + mapper668 schema; uses existing Python mapping worker, not collection.
FINANCIAL_MAPPING_ENABLED=false

# Explicit opt-in only. Does not adopt/restart legacy collection jobs.
RECOVERY_COORDINATOR_ENABLED=false
# Must match the DB outbox fence; control649 uses trader.raw.coordinated.ready649.
RECOVERY_RAW_TOPIC=trader.raw.coordinated.ready
# New admin NEWS plans/schedules use the durable path only when explicitly enabled.
NEWS_RECOVERY_ENABLED=false
